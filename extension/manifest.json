{
  "manifest_version":3,
  "name":"Marathi Hate Speech & Cyber Bullying Detector",
  "version":"2.0",
  "description":"Real-time Marathi hate speech and cyber bullying detection for social media.",
  "permissions":["storage"],
  "host_permissions":["http://127.0.0.1:5000/*","http://localhost:5000/*"],
  "background":{"service_worker":"background.js"},
  "action":{"default_popup":"popup.html"},
  "content_scripts":[
    {
      "matches":[
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://www.instagram.com/*",
        "https://www.facebook.com/*",
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js":["content.js"],
      "css":["style.css"],
      "run_at":"document_start"
    }
  ]
}